# Claude Code SDK provider configuration
# Copy to .env locally and replace placeholder values.

ANTHROPIC_AUTH_TOKEN=your_provider_token_here
ANTHROPIC_BASE_URL=https://api.minimaxi.com/anthropic
ANTHROPIC_DEFAULT_HAIKU_MODEL=MiniMax-M2.7
ANTHROPIC_DEFAULT_OPUS_MODEL=MiniMax-M2.7
ANTHROPIC_DEFAULT_SONNET_MODEL=MiniMax-M2.7
ANTHROPIC_MODEL=MiniMax-M2.7
API_TIMEOUT_MS=3000000
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1

# Optional Claude Code client behavior flags used in local development.
CLAUDE_CODE_INCLUDE_CO_AUTHORED_BY=false
CLAUDE_CODE_SKIP_DANGEROUS_MODE_PERMISSION_PROMPT=true

# Example plugin toggles used in this repo's local setup.
CLAUDE_CODE_ENABLED_PLUGIN_SUPERPOWERS=true
CLAUDE_CODE_ENABLED_PLUGIN_SWIFT_LSP=true
